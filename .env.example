# Only used when running the app directly (npm run dev/build) against a database you
# already have reachable at this address. Under `docker compose up`, this value is ignored —
# docker-compose.yml builds the app's real DATABASE_URL itself from POSTGRES_PASSWORD below,
# pointed at the "postgres" service on the Compose network.
DATABASE_URL="postgresql://user:password@localhost:5432/chainsync"

# Password for the Postgres container docker-compose.yml starts. Only read by Docker Compose.
POSTGRES_PASSWORD="changeme"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="changeme"

# SMTP for magic-link sign-in (Admin/Finance/Procurement/Customer). Any self-hosted or
# free-tier SMTP relay works (Postfix, Mailhog for local dev, etc.).
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="ChainSync <no-reply@chainsync.example.com>"

# Shared secret for the scheduled-job endpoint (app/api/cron/route.ts). Generate with:
# openssl rand -hex 32
CRON_SECRET="changeme"
